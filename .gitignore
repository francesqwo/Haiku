# Nothing from the game ever goes in this repository: not your dump, not the
# files installed or made from it, not recompiled code, not saves.
/data/
/game/
/runs/
/userdata/
/cache/
/mods/
/mods-examples/
/source/code/
/work/
/setup-work/
target/
