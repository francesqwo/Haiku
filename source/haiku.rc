// Haiku.exe's name in Explorer, Task Manager and the taskbar
#include <winver.h>

// the icon Explorer, shortcuts and the taskbar show
1 ICON "haiku.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Haiku"
            VALUE "ProductName",      "Haiku"
            VALUE "InternalName",     "Haiku"
            VALUE "OriginalFilename", "Haiku.exe"
            VALUE "FileVersion",      "0.1.0"
            VALUE "ProductVersion",   "0.1.0"
            VALUE "Comments",         "Fire Emblem Fates, recompiled for PC"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
